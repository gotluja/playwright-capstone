{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["playwright.config.ts", "pages/**/*.ts", "fixtures/**/*.ts", "utils/**/*.ts", "testdata/**/*.ts", "tests/**/*.ts", "config/**/*.ts"]
}
